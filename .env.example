# Database
POSTGRES_USER=premai
POSTGRES_PASSWORD=premai_secret
POSTGRES_DB=premai_db
DATABASE_URL=postgresql+asyncpg://premai:premai_secret@localhost:5432/premai_db

# Redis
REDIS_URL=redis://localhost:6379/0

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Auth
SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
ENVIRONMENT=development
DEBUG=true

# OCR — provider: claude | gemini | openai | ensemble
OCR_PROVIDER=claude
OCR_ENSEMBLE_PROVIDERS=claude,gemini
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
OPENAI_API_KEY=sk-...

# Discovery agent
TAVILY_API_KEY=tvly-...

# Uploads
UPLOAD_DIR=uploads/tickets